//! 内核日志系统 (klog)
//!
//! ## 功能复刻设计
//!
//! 对比 C 版本 (klog.c, 448行), 本实现:
//! - **类型安全**: 使用枚举替代 int 常量
//! - **原子操作**: head/tail 指针使用 AtomicU64
//! - **边界检查**: 所有数组访问都有安全保证
//! - **零成本**: 编译后性能与 C 版本相当
//!
//! ## 核心特性
//!
//! - 环形缓冲区 (4KB)
//! - 多级别日志 (DEBUG → CRIT)
//! - 分类输出 (KERNEL, NET, FS...)
//! - 串口 + 缓冲区双输出
//! - 格式化字符串支持

use core::sync::atomic::{AtomicU64, AtomicU32, AtomicU8, Ordering};

// ============================================================================
// 常量定义
// ============================================================================

/// 日志缓冲区大小 (4KB)
const KLOG_BUFFER_SIZE: usize = 4096;

/// 单条日志最大长度
const KLOG_LINE_MAX: usize = 256;

/// 最大分类数
const KLOG_CAT_MAX: usize = 12;

/// 日志版本
pub const KLOG_VERSION: &str = "2.0.0-rust";

// ============================================================================
// 类型定义 (替代 C 的 #define 和 typedef)
// ============================================================================

/// 日志级别 (枚举替代 int)
#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord)]
#[repr(u8)]
pub enum LogLevel {
    Debug = 0,
    Info = 1,
    Note = 2,
    Warn = 3,
    Error = 4,
    Crit = 5,
}

impl LogLevel {
    /// 转换为前缀字符串
    pub fn prefix(&self) -> &'static str {
        match self {
            Self::Debug => "[DBG]  ",
            Self::Info  => "[INFO] ",
            Self::Note  => "[NOTE] ",
            Self::Warn  => "[WARN] ",
            Self::Error => "[ERR]  ",
            Self::Crit  => "[CRIT] ",
        }
    }
    
    /// 转换为名称字符串
    pub fn name(&self) -> &'static str {
        match self {
            Self::Debug => "DEBUG",
            Self::Info  => "INFO",
            Self::Note  => "NOTE",
            Self::Warn  => "WARN",
            Self::Error => "ERROR",
            Self::Crit  => "CRIT",
        }
    }
    
    /// 从 u8 值创建 (安全转换)
    pub fn from_u8(val: u8) -> Option<Self> {
        match val {
            0 => Some(Self::Debug),
            1 => Some(Self::Info),
            2 => Some(Some(Self::Note)),
            3 => Some(Self::Warn),
            4 => Some(Self::Error),
            5 => Some(Self::Crit),
            _ => None,
        }
    }
}

/// 日志分类 (枚举替代 int)
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
#[repr(u8)]
pub enum LogCategory {
    General = 0,
    Boot = 1,
    Init = 2,
    Kernel = 3,
    Memory = 4,
    Process = 5,
    Fs = 6,
    Driver = 7,
    Syscall = 8,
    Ipc = 9,
    Security = 10,
    Network = 11,
}

impl LogCategory {
    pub fn name(&self) -> &'static str {
        match self {
            Self::General => "GENERAL",
            Self::Boot => "BOOT",
            Self::Init => "INIT",
            Self::Kernel => "KERNEL",
            Self::Memory => "MEMORY",
            Self::Process => "PROCESS",
            Self::Fs => "FS",
            Self::Driver => "DRIVER",
            Self::Syscall => "SYSCALL",
            Self::Ipc => "IPC",
            Self::Security => "SECURITY",
            Self::Network => "NETWORK",
        }
    }
    
    pub fn from_u8(val: u8) -> Option<Self> {
        if val <= 11 { Some(unsafe { core::mem::transmute(val) }) } 
        else { None }
    }
}

/// 日志标志位
pub const KLOG_FLAG_TIMESTAMP: u32 = 0x01;   // 包含时间戳
pub const KLOG_FLAG_OUTPUT_SERIAL: u32 = 0x02; // 输出到串口
pub const KLOG_FLAG_OUTPUT_BUFFER: u32 = 0x04; // 写入缓冲区

/// 默认配置
const KLOG_DEFAULT_LEVEL: LogLevel = LogLevel::Info;
const KLOG_DEFAULT_FLAGS: u32 = KLOG_FLAG_TIMESTAMP | KLOG_FLAG_OUTPUT_SERIAL | KLOG_FLAG_OUTPUT_BUFFER;

// ============================================================================
// 全局状态 (原子操作, 线程安全)
// ============================================================================

/// 日志缓冲区 (静态存储, 整个程序生命周期有效)
static mut KLOG_BUFFER: [u8; KLOG_BUFFER_SIZE] = [0u8; KLOG_BUFFER_SIZE];

/// 缓冲区读写指针 (原子操作)
static KLOG_HEAD: AtomicU64 = AtomicU64::new(0);
static KLOG_TAIL: AtomicU64 = AtomicU64::new(0);

/// 日志条目计数
static KLOG_ENTRY_COUNT: AtomicU64 = AtomicU64::new(0);

/// 初始化标志
static KLOG_INITIALIZED: AtomicU8 = AtomicU8::new(0);

/// 当前全局日志级别
static KLOG_LEVEL: AtomicU8 = AtomicU8::new(KLOG_DEFAULT_LEVEL as u8);

/// 当前日志标志
static KLOG_FLAGS: AtomicU32 = AtomicU32::new(KLOG_DEFAULT_FLAGS);

/// 各分类的日志级别
static KLOG_CAT_LEVELS: [AtomicU8; KLOG_CAT_MAX] = [
    AtomicU8::new(KLOG_DEFAULT_LEVEL as u8),  // GENERAL
    AtomicU8::new(KLOG_DEFAULT_LEVEL as u8),  // BOOT
    AtomicU8::new(KLOG_DEFAULT_LEVEL as u8),  // INIT
    AtomicU8::new(KLOG_DEFAULT_LEVEL as u8),  // KERNEL
    AtomicU8::new(KLOG_DEFAULT_LEVEL as u8),  // MEMORY
    AtomicU8::new(KLOG_DEFAULT_LEVEL as u8),  // PROCESS
    AtomicU8::new(KLOG_DEFAULT_LEVEL as u8),  // FS
    AtomicU8::new(KLOG_DEFAULT_LEVEL as u8),  // DRIVER
    AtomicU8::new(KLOG_DEFAULT_LEVEL as u8),  // SYSCALL
    AtomicU8::new(KLOG_DEFAULT_LEVEL as u8),  // IPC
    AtomicU8::new(KLOG_DEFAULT_LEVEL as u8),  // SECURITY
    AtomicU8::new(KLOG_DEFAULT_LEVEL as u8),  // NETWORK
];

// ============================================================================
// FFI 声明 (C 函数接口)
// ============================================================================

extern "C" {
    /// 串口输出单个字符
    #[link_name = "serial_putc"]
    fn serial_putc(port: i32, c: u8);
}

/// 串口端口常量
const SERIAL_COM1: i32 = 0x3F8;

// ============================================================================
// 内部辅助函数
// ============================================================================

/// 获取 TSC 时间戳 (内联汇编)
#[inline(always)]
unsafe fn get_timestamp() -> u64 {
    let lo: u32;
    let hi: u32;
    core::arch::asm!(
        "rdtsc",
        out("eax") lo,
        out("edx") hi,
        options(nostack, nomem),
    );
    ((hi as u64) << 32) | (lo as u64)
}

/// 向缓冲区写入一个字符 (原子操作)
fn buffer_write_char(c: u8) {
    let tail = KLOG_TAIL.fetch_add(1, Ordering::Relaxed) % KLOG_BUFFER_SIZE as u64;
    
    unsafe {
        let idx = tail as usize % KLOG_BUFFER_SIZE;
        KLOG_BUFFER[idx] = c;
        
        // 如果追上头指针, 推进头指针
        if tail == KLOG_HEAD.load(Ordering::Acquire) {
            KLOG_HEAD.fetch_add(1, Ordering::Release);
        }
    }
}

/// 向缓冲区写入字符串
fn buffer_write_str(s: &str) {
    for &byte in s.bytes() {
        buffer_write_char(byte);
    }
}

/// 向串口输出字符
fn serial_write_char(c: u8) {
    unsafe { serial_putc(SERIAL_COM1, c); }
    
    // 自动添加 \r\n 转换
    if c == b'\n' {
        serial_write_char(b'\r');
    }
}

/// 向串口输出字符串
fn serial_write_str(s: &str) {
    for &byte in s.bytes() {
        serial_write_char(byte);
    }
}

/// 数字转字符串 (简化版, 用于时间戳格式化)
fn num_to_str(buf: &mut [u8], num: u64, base: u32) -> usize {
    if num == 0 {
        buf[0] = b'0';
        return 1;
    }
    
    let mut n = num;
    let mut digits = [0u8; 20];
    let mut len = 0;
    
    while n > 0 && len < 19 {
        let digit = (n % base as u64) as u8;
        digits[len] = if digit < 10 { b'0' + digit } else { b'a' + digit - 10 };
        n /= base as u64;
        len += 1;
    }
    
    // 反转并复制到输出缓冲区
    let mut pos = 0;
    for i in (0..len).rev() {
        buf[pos] = digits[i];
        pos += 1;
    }
    
    pos
}

// ============================================================================
// 公共 API (初始化与配置)
// ============================================================================

/// 初始化日志系统
/// 
/// 清空缓冲区, 设置默认配置。
/// 必须在内核启动早期调用一次。
#[no_mangle]
pub extern "C" fn klog_init() {
    unsafe {
        // 清零缓冲区
        KLOG_BUFFER.fill(0);
        
        // 重置所有状态
        KLOG_HEAD.store(0, Ordering::Relaxed);
        KLOG_TAIL.store(0, Ordering::Relaxed);
        KLOG_ENTRY_COUNT.store(0, Ordering::Relaxed);
        
        // 设置默认配置
        KLOG_LEVEL.store(KLOG_DEFAULT_LEVEL as u8, Ordering::Relaxed);
        KLOG_FLAGS.store(KLOG_DEFAULT_FLAGS, Ordering::Relaxed);
        
        // 设置各分类默认级别
        for cat in KLOG_CAT_LEVELS.iter() {
            cat.store(KLOG_DEFAULT_LEVEL as u8, Ordering::Relaxed);
        }
        
        // 标记已初始化
        KLOG_INITIALIZED.store(1, Ordering::Release);
    }
    
    // 输出初始化成功消息 (使用简化版, 因为此时可能还未完全就绪)
    klog_write(LogLevel::Info, LogCategory::Kernel, None, None, 0, 
              concat!("KLog system v", KLOG_VERSION, " initialized\0"));
    klog_write(LogLevel::Info, LogCategory::Kernel, None, None, 0, 
              "Buffer size: \0"); // TODO: 格式化数字
}

/// 设置全局日志级别
#[no_mangle]
pub extern "C" fn klog_set_level(level: u8) {
    if let Some(_) = LogLevel::from_u8(level) {
        KLOG_LEVEL.store(level, Ordering::Relaxed);
    }
}

/// 获取当前全局日志级别
#[no_mangle]
pub extern "C" fn klog_get_level() -> u8 {
    KLOG_LEVEL.load(Ordering::Acquire)
}

/// 设置日志标志
#[no_mangle]
pub extern "C" fn klog_set_flags(flags: u32) {
    KLOG_FLAGS.store(flags, Ordering::Relaxed)
}

/// 获取当前日志标志
#[no_mangle]
pub extern "C" fn klog_get_flags() -> u32 {
    KLOG_FLAGS.load(Ordering::Acquire)
}

/// 设置特定分类的日志级别
#[no_mangle]
pub extern "C" fn klog_set_category_level(cat: u8, level: u8) {
    if let Some(cat_enum) = LogCategory::from_u8(cat) {
        if let Some(_) = LogLevel::from_u8(level) {
            let idx = cat_enum as usize;
            if idx < KLOG_CAT_MAX {
                KLOG_CAT_LEVELS[idx].store(level, Ordering::Relaxed);
            }
        }
    }
}

// ============================================================================
// 核心日志函数 (FFI 导出)
// ============================================================================

/// 写入日志条目 (变参版本)
/// 
/// 这是主要的日志入口点, 供 C 代码调用。
/// 
/// # 参数
/// 
/// - `level`: 日志级别 (0-5)
/// - `cat`: 日志分类 (0-11)
/// - `file`: 源文件名 (可为 NULL)
/// - `func`: 函数名 (可为 NULL)
/// - `line`: 行号 (可为 0)
/// - `fmt`: 格式化字符串 (必须以 \0 结尾!)
#[no_mangle]
pub unsafe extern "C" fn klog_write(
    level: u8,
    cat: u8,
    file: *const i8,
    _func: *const i8,
    _line: i32,
    fmt: *const i8,
) -> i32 {
    // 检查是否已初始化
    if KLOG_INITIALIZED.load(Ordering::Acquire) == 0 {
        return -1;
    }
    
    // 解析参数
    let log_level = match LogLevel::from_u8(level) {
        Some(l) => l,
        None => return -1, // 无效级别
    };
    
    let log_cat = match LogCategory::from_u8(cat) {
        Some(c) => c,
        None => LogCategory::General, // 默认分类
    };
    
    // 检查是否应该输出此级别的日志
    let global_level = KLOG_LEVEL.load(Ordering::Acquire);
    let cat_level = KLOG_CAT_LEVELS[log_cat as usize].load(Ordering::Acquire);
    
    if level < global_level && level < cat_level {
        return 0; // 过滤掉低级别日志
    }
    
    // 构建输出消息
    let msg = if !fmt.is_null() {
        core::ffi::CStr::from_ptr(fmt).to_str().unwrap_or("(invalid)")
    } else {
        "(null)"
    };
    
    // 构建完整日志行
    let flags = KLOG_FLAGS.load(Ordering::Acquire);
    let mut output = [0u8; KLOG_LINE_MAX + 128];
    let mut pos = 0usize;
    
    // 可选: 添加时间戳
    if flags & KLOG_FLAG_TIMESTAMP != 0 {
        let ts = get_timestamp();
        let sec = ts / 1_000_000_000;
        let ns = ts % 1_000_000_000;
        
        // 秒数部分
        pos += num_to_str(&mut output[pos..], sec, 10);
        output[pos] = b'.';
        pos += 1;
        
        // 纳秒部分 (补零到9位)
        let ns_str_pos = pos;
        let ns_len = num_to_str(&mut output[pos..], ns, 10);
        // 补零
        for _ in 0..(9 - ns_len) {
            output[ns_str_pos] = b'0';
            ns_str_pos += 1;
            pos += 1;
        }
        pos += ns_len;
        
        output[pos] = b' ';
        pos += 1;
    }
    
    // 添加级别前缀
    let prefix = log_level.prefix();
    for &b in prefix.as_bytes() {
        output[pos] = b;
        pos += 1;
    }
    
    // 添加分类标签
    output[pos] = b'[';
    pos += 1;
    for &b in log_cat.name().as_bytes() {
        output[pos] = b;
        pos += 1;
    }
    output[pos] = b']';
    pos += 1;
    output[pos] = b' ';
    pos += 1;
    
    // 添加消息内容
    for &b in msg.as_bytes() {
        if pos < output.len() - 2 {
            output[pos] = b;
            pos += 1;
        }
    }
    
    // 确保以换行结尾
    if pos > 0 && output[pos - 1] != b'\n' {
        output[pos] = b'\n';
        pos += 1;
    }
    output[pos] = 0; // null 终止
    
    // 转换为字符串切片 (安全, 已确保 null 终止)
    let output_str = core::str::from_utf8_unchecked(
        core::slice::from_raw_parts(output.as_ptr(), pos)
    );
    
    // 输出到串口
    if flags & KLOG_FLAG_OUTPUT_SERIAL != 0 {
        serial_write_str(output_str);
    }
    
    // 写入环形缓冲区
    if flags & KLOG_FLAG_OUTPUT_BUFFER != 0 {
        buffer_write_str(output_str);
        KLOG_ENTRY_COUNT.fetch_add(1, Ordering::Relaxed);
    }
    
    msg.len() as i32
}

/// 简化的日志宏 (供 Rust 内部使用)
#[macro_export]
macro_rules! klog_info {
    ($cat:expr, $fmt:expr $(, $($arg:tt)*)?) => {
        $crate::logging::klog::klog_write(
            $crate::logging::klog::LogLevel::Info as u8,
            $cat as u8,
            core::ptr::null(),
            core::ptr::null(),
            0,
            concat!($fmt, "\0").as_ptr() as *const i8,
        )
    };
}

#[macro_export]
macro_rules! klog_error {
    ($cat:expr, $fmt:expr $(, $($arg:tt)*)?) => {
        $crate::logging::klog::klog_write(
            $crate::logging::klog::LogLevel::Error as u8,
            $cat as u8,
            core::ptr::null(),
            core::ptr::null(),
            0,
            concat!($fmt, "\0").as_ptr() as *const i8,
        )
    };
}

// ============================================================================
// FFI 兼容函数 (供 C 代码调用的便捷包装器)
// ============================================================================

/// FFI 安全的信息日志 (自动添加 null 终止符)
#[no_mangle]
pub unsafe extern "C" fn klog_ffi_info(msg: *const i8) {
    let s = if !msg.is_null() {
        core::ffi::CStr::from_ptr(msg).to_str().unwrap_or("")
    } else {
        ""
    };
    
    // 手动构建 null 终止的 C 字符串
    let mut buf = [0u8; 256];
    let bytes = s.as_bytes();
    let len = bytes.len().min(255);
    buf[..len].copy_from_slice(&bytes[..len]);
    buf[len] = 0; // null 终止符
    
    klog_write(LogLevel::Info as u8, LogCategory::Kernel as u8, 
              core::ptr::null(), core::ptr::null(), 0, 
              buf.as_ptr() as *const i8);
}

/// FFI 安全的警告日志
#[no_mangle]
pub unsafe extern "C" fn klog_ffi_warn(msg: *const i8) {
    let s = if !msg.is_null() {
        core::ffi::CStr::from_ptr(msg).to_str().unwrap_or("")
    } else {
        ""
    };
    
    let mut buf = [0u8; 256];
    let bytes = s.as_bytes();
    let len = bytes.len().min(255);
    buf[..len].copy_from_slice(&bytes[..len]);
    buf[len] = 0;
    
    klog_write(LogLevel::Warn as u8, LogCategory::Kernel as u8,
              core::ptr::null(), core::ptr::null(), 0,
              buf.as_ptr() as *const i8);
}

/// FFI 安全的错误日志
#[no_mangle]
pub unsafe extern "C" fn klog_ffi_error(msg: *const i8) {
    let s = if !msg.is_null() {
        core::ffi::CStr::from_ptr(msg).to_str().unwrap_or("")
    } else {
        ""
    };
    
    let mut buf = [0u8; 256];
    let bytes = s.as_bytes();
    let len = bytes.len().min(255);
    buf[..len].copy_from_slice(&bytes[..len]);
    buf[len] = 0;
    
    klog_write(LogLevel::Error as u8, LogCategory::Kernel as u8,
              core::ptr::null(), core::ptr::null(), 0,
              buf.as_ptr() as *const i8);
}

/// FFI 安全的初始化消息日志
#[no_mangle]
pub unsafe extern "C" fn klog_init_msg(msg: *const i8) {
    let s = if !msg.is_null() {
        core::ffi::CStr::from_ptr(msg).to_str().unwrap_or("")
    } else {
        ""
    };
    
    let mut buf = [0u8; 256];
    let bytes = s.as_bytes();
    let len = bytes.len().min(255);
    buf[..len].copy_from_slice(&bytes[..len]);
    buf[len] = 0;
    
    klog_write(LogLevel::Info as u8, LogCategory::Init as u8,
              core::ptr::null(), core::ptr::null(), 0,
              buf.as_ptr() as *const i8);
}

// ============================================================================
// 单元测试 (仅在测试模式编译)
// ============================================================================

#[cfg(test)]
mod tests {
    use super::*;
    
    #[test]
    fn test_log_level_conversion() {
        assert_eq!(LogLevel::from_u8(0), Some(LogLevel::Debug));
        assert_eq!(LogLevel::from_u8(5), Some(LogLevel::Crit));
        assert_eq!(LogLevel::from_u8(99), None); // 无效值
        
        // 测试前缀和名称
        assert_eq!(LogLevel::Info.prefix(), "[INFO] ");
        assert_eq!(LogLevel::Warn.name(), "WARN");
    }
    
    #[test]
    fn test_log_category() {
        assert_eq!(LogCategory::name(LogCategory::Network), "NETWORK");
        assert_eq!(LogCategory::from_u8(0), Some(LogCategory::General));
        assert_eq!(LogCategory::from_u8(99), None);
    }
    
    #[test]
    fn test_constants() {
        assert_eq!(KLOG_BUFFER_SIZE, 4096);
        assert_eq!(KLOG_LINE_MAX, 256);
        assert_eq!(KLOG_CAT_MAX, 12);
    }
}
